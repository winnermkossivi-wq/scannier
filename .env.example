# Exemple de variables d'environnement pour Scannier.
# Copier ce fichier en ".env" et renseigner les valeurs (jamais de secrets reels dans le depot).
# Toutes les valeurs ci-dessous sont volontairement vides ou a titre d'exemple.

# ---------------------------------------------------------------------------
# SECURITE CORE
# ---------------------------------------------------------------------------
# Cle secrete Django (obligatoire en production). Generer avec :
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# True en developpement local, False en production
DJANGO_DEBUG=True

# True en production : active HTTPS, cookies securises, HSTS
DJANGO_SECURE=False

# Hotes autorises (separes par des virgules) - OBLIGATOIRE en prod
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (origines du front-end, separees par des virgules)
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CORS_ALLOW_CREDENTIALS=False

# Rate limiting DRF
DJANGO_API_RATE_ANON=60/min
DJANGO_API_RATE_USER=1000/hour

# Rate limiting page de connexion (login) - req/min par IP
DJANGO_LOGIN_RATE_LIMIT=10/min

# HSTS (en secondes, quand DJANGO_SECURE=True)
DJANGO_HSTS_SECONDS=31536000

# Origines de confiance pour les cookies CSRF (ex: https://caisse.scannier.app)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Expiration session (secondes) - 8h par defaut
DJANGO_SESSION_COOKIE_AGE=28800
DJANGO_SESSION_SAVE_EVERY_REQUEST=True
DJANGO_SESSION_EXPIRE_AT_BROWSER_CLOSE=True

# ---------------------------------------------------------------------------
# BASE DE DONNEES (production : PostgreSQL)
# ---------------------------------------------------------------------------
# En developpement SQLite est utilise par defaut. En production, renseigner
# DATABASE_URL pour basculer sur PostgreSQL (dj-database-url la parse).
# Format : postgres://UTILISATEUR:MOTDEPASSE@HOTE:5432/NOM_DB
# Exemple :
# DATABASE_URL=postgres://scannier:Az3rtY_M0tD3P@db.scannier.app:5432/scannier
DATABASE_URL=

# ---------------------------------------------------------------------------
# UPLOAD FICHIERS
# ---------------------------------------------------------------------------
# Taille max upload (octets) - 5MB par defaut
DJANGO_MAX_UPLOAD_SIZE=5242880
# Types MIME autorises (virgules) - images + PDF uniquement
DJANGO_ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ---------------------------------------------------------------------------
# WEBHOOKS / INTEGRATIONS
# ---------------------------------------------------------------------------
# Cle secrete pour signature webhook (HMAC-SHA256) - generer une cle aleatoire
WEBHOOK_SECRET_KEY=

# ---------------------------------------------------------------------------
# FRONTEND
# ---------------------------------------------------------------------------
# False -> le navigateur appelle les vrais endpoints /api/ (production).
# True  -> le navigateur utilise des donnees simulees (developpement / demo).
FRONTEND_USE_MOCK=False

# ---------------------------------------------------------------------------
# CLE PUBLIQUE CLIENT (pour chiffrement cote navigateur si necessaire)
# ---------------------------------------------------------------------------
# Clé publique RSA/EC en format PEM (une ligne, \n echappes) pour chiffrement cote client
CLIENT_PUBLIC_KEY=